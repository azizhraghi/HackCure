# =====================================================================
# SURGIGUARD AI - BACKEND CONFIGURATION (copy to .env; never commit .env)
# =====================================================================
# One shared LLM layer for D2 (documents, RAG assistant) and D3 (agents).
# Provider: groq | openrouter | mistral | auto (first one with a key)
LLM_PROVIDER=auto
# stub = canned outputs, no network | live = the provider | off = simulate the LLM being down
# (defaults to live when a key is set, stub otherwise)
# LLM_MODE=live

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=poolside/laguna-s-2.1:free
# Mistral also enables Pixtral OCR for scanned PDFs / photos of documents and Mistral embeddings for RAG
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Optional per-feature routing (provider:model), e.g. to spread free-tier quotas:
# LLM_ROUTE_INVESTIGATION=openrouter:poolside/laguna-s-2.1:free
# LLM_ROUTE_CHECKIN_CLARIFY=groq:openai/gpt-oss-20b
# LLM_ROUTE_DIGEST=groq:openai/gpt-oss-20b
# LLM_ROUTE_CHAT=groq:openai/gpt-oss-120b
# LLM_ROUTE_PROTOCOL=groq:openai/gpt-oss-120b
# LLM_ROUTE_D2=groq:openai/gpt-oss-20b       # D2 extraction, safety check, RAG assistant (LangChain); default: Groq gpt-oss-20b

# Demo timeouts in seconds
ACK_TIMEOUT_S=60
INVESTIGATION_TIMEOUT_S=120
REQUEST_TIMEOUT_S=90

# D2 RAG vectorstore
VECTORSTORE_PATH=./data/vectorstore
