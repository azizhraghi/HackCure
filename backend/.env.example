# =====================================================================
# SURGIGUARD AI - BACKEND CONFIGURATION
# =====================================================================

# LLM Provider: "auto" (default), "mistral", or "groq"
LLM_PROVIDER=auto

# Option A: Mistral AI (Official Provider)
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest

# Option B: Groq (Ultra-fast Llama-3 Alternative, free tier)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Vectorstore path
VECTORSTORE_PATH=./data/vectorstore
