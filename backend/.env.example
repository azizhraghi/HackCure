MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-medium-latest
# stub = canned agent outputs (no network) | live = Mistral | off = simulate the LLM being down
LLM_MODE=live
# Demo timeouts in seconds
ACK_TIMEOUT_S=60
INVESTIGATION_TIMEOUT_S=120
REQUEST_TIMEOUT_S=90
# Provider: mistral (default) or groq. For Groq set these three:
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-120b
# Or OpenRouter (free models available):
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_MODEL=poolside/laguna-s-2.1:free
# Optional per-feature routing (provider:model), e.g. to spread free-tier quotas:
# LLM_ROUTE_INVESTIGATION=openrouter:poolside/laguna-s-2.1:free
# LLM_ROUTE_CHECKIN_CLARIFY=groq:openai/gpt-oss-20b
# LLM_ROUTE_DIGEST=groq:openai/gpt-oss-20b
