MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-medium-latest
# stub = canned agent outputs (no network) | live = Mistral | off = simulate the LLM being down
LLM_MODE=live
# Demo timeouts in seconds
ACK_TIMEOUT_S=60
INVESTIGATION_TIMEOUT_S=120
REQUEST_TIMEOUT_S=90
# Provider: mistral (default) or groq. For Groq set these three:
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=llama-3.3-70b-versatile
